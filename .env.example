# Frontend build-time settings. Do not put client secrets here.
# Every value below is a placeholder and is deliberately rejected by npm run build.
NEXT_PUBLIC_APP_MODE=production
NEXT_PUBLIC_AUTH_MODE=entra

# TMT ID (Keycloak) instead of Microsoft Entra: set NEXT_PUBLIC_AUTH_MODE=tmt-id.
# The three NEXT_PUBLIC_ENTRA_* values below are then unused and unvalidated --
# TMT ID is a confidential client that lives in backend-node, so the browser
# holds no identity-provider settings at all. The API-side variables are
# documented in backend-node/README.md.
NEXT_PUBLIC_API_BASE_URL=https://iot-api.example.tomastc.com
NEXT_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
NEXT_PUBLIC_BUSINESS_TIME_ZONE=Asia/Bangkok

# Trusted public origin used for Open Graph metadata.
SITE_ORIGIN=https://iot-team-center.example.tomastc.com
