# TLS terminator for docker-compose.tls.yml. Certificates come from Cloudflare DNS-01, so the
# host never has to expose 80/443 for ACME and the same hostname can sit on non-standard
# ports when 443 is already taken by another tenant.

{
	# git push over HTTPS is full duplex: receive-pack starts answering (progress, keepalives) while
	# the pack is still being uploaded. Go's HTTP/1 server ends the request body as soon as the
	# response starts, so index-pack got a truncated pack ("premature end of pack file, N bytes
	# missing"). HTTP/2 is full duplex by design; enable_full_duplex does the same for HTTP/1
	# clients. No body timeout either, so a slow VPN link can take as long as it needs.
	servers :{$TMTHUB_PORT} {
		enable_full_duplex
		timeouts {
			read_body 0
		}
	}
}

(cloudflare_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
}

{$PUBLIC_HOST}:{$TLS_FRONTEND_PORT} {
	import cloudflare_tls
	# Every backend route lives under /api or /health and the frontend owns none of them, so the
	# API is served on the app origin: the BFF session cookie is first-party and no CORS preflight
	# is involved. The :{$TLS_API_PORT} site below keeps direct API access for operators.
	handle /api/* {
		reverse_proxy api:5106
	}
	handle /health/* {
		reverse_proxy api:5106
	}
	handle {
		reverse_proxy frontend:3000
	}
}

{$PUBLIC_HOST}:{$TLS_API_PORT} {
	import cloudflare_tls
	reverse_proxy api:5106
}

# TMTHub (Forgejo). Same certificate path; the A record points at the tailnet address, so it is
# reachable over the VPN only. No body limit: a first push of a large repository is one request.
{$TMTHUB_HOST}:{$TMTHUB_PORT} {
	import cloudflare_tls
	reverse_proxy tmthub:3000
}
