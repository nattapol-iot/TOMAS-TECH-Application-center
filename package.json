{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:ocr": "bun scripts/prepare-ocr-assets.mjs",
    "dev": "bun run prepare:ocr && bun --bun vinext dev",
    "build": "bun scripts/guard-running-frontend-build.mjs && bun run prepare:ocr && bun scripts/validate-production-env.mjs && bun --bun vinext build",
    "build:local": "bun scripts/guard-running-frontend-build.mjs && bun run prepare:ocr && bun --bun vinext build",
    "start": "bun --bun vinext start",
    "test": "bun run lint && bun run typecheck && bun test ./tests/",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "oxlint",
    "fmt": "bun scripts/format-changed.mjs",
    "fmt:check": "bun scripts/format-changed.mjs --check"
  },
  "dependencies": {
    "@azure/msal-browser": "5.20.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/tha": "1.0.0",
    "fflate": "^0.7.4",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sweetalert2": "11.26.25",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.3",
    "mssql": "^12.7.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "pdf-lib": "^1.17.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "engines": {
    "bun": ">=1.4.5"
  }
}
