{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "predev": "npm run prepare:ocr",
    "prebuild": "npm run prepare:ocr",
    "prebuild:local": "npm run prepare:ocr",
    "prebuild:vercel": "npm run prepare:ocr",
    "dev": "vinext dev",
    "build": "node scripts/validate-production-env.mjs && vinext build",
    "build:local": "vinext build",
    "build:vercel": "node scripts/validate-vercel-env.mjs && vite build",
    "start": "vinext start",
    "test": "npm run lint && npm run typecheck && node --test --test-isolation=none tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel"
  },
  "dependencies": {
    "@azure/msal-browser": "5.20.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/tha": "1.0.0",
    "fflate": "^0.7.4",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.3",
    "globals": "16.4.0",
    "mssql": "^12.7.0",
    "nitro": "^3.0.260610-beta",
    "pdf-lib": "^1.17.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
