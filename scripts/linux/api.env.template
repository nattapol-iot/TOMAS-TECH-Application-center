# Reviewed template for the IoT Team Center API container's env file on Ubuntu.
#
# Copy this file to /etc/iot-team-center/api.env.input (outside the repository), replace
# every <PLACEHOLDER> below with a real reviewed value, then run deploy.sh. Never commit
# the filled-in copy. docker-compose.prod.yml references this exact path via
# `env_file:`, and deploy.sh refuses to proceed if any <PLACEHOLDER> marker is still
# present.
#
# This is a plain KEY=VALUE file (Docker Compose / systemd EnvironmentFile format): no
# quoting is needed even for values containing spaces or semicolons (e.g. the SQL
# connection string). Double underscores are the ASP.NET Core environment-variable
# configuration convention.

ASPNETCORE_ENVIRONMENT=Production

# Exact hostname (or bare IP if there's no domain yet) of this API -- no scheme, no
# path, no port -- e.g. iot-api.example.tomastc.com, or 203.0.113.10
AllowedHosts=<API_HOST>

Authentication__Mode=Entra
# Microsoft Entra tenant ID (GUID). If Entra is not registered yet, a temporary
# non-empty random GUID (e.g. from `uuidgen`) lets the API start for infrastructure
# testing, but sign-in will not work until this is the tenant's real ID.
Authentication__TenantId=<TENANT_ID_GUID>
# API app registration's client ID (GUID) -- not the frontend SPA's client ID.
Authentication__ClientId=<API_CLIENT_ID_GUID>
# Must equal Authentication__ClientId for a v2 access token (see docs/PRODUCTION_DEPLOYMENT.md).
Authentication__Audience=<API_CLIENT_ID_GUID>
Authentication__RequiredScope=access_as_user

# Exact public frontend origin; no wildcard, path, or trailing slash. HTTPS only --
# ASP.NET Core enforces this even without a real domain (self-signed HTTPS is fine,
# plain HTTP is not). Include the port if it isn't 443, e.g. https://203.0.113.10:443
# or https://203.0.113.10 (same thing) -- match whatever --frontend-external-port
# install-production-host.sh actually bound.
Cors__AllowedOrigins__0=<FRONTEND_ORIGIN>

Business__TimeZoneId=SE Asia Standard Time

# Connection string for the dedicated least-privileged SQL login (never sa/admin).
# SQL Server lives on a separate host that this script never configures.
# Server=tcp:<SQL_FQDN>,1433;Database=IoTTeamCenter;User ID=iot_team_app;Password=<FROM_SECRET_MANAGER>;Encrypt=True;TrustServerCertificate=False;Persist Security Info=False;
ConnectionStrings__IoTTeamCenter=<SQL_CONNECTION_STRING>

# Mode is 'Nas' even on Ubuntu: RootPath must be the local mount point of the real NAS
# share (mounted via CIFS by install-production-host.sh on the HOST, then bind-mounted
# into the API container at this same path by docker-compose.prod.yml). The API verifies
# at startup that this exact path is currently a mounted filesystem inside the container
# (not just an ordinary folder) on non-Windows hosts -- see
# DocumentStorageOptions.ValidateAndNormalizeUncRoot.
DocumentStorage__Mode=Nas
DocumentStorage__RootPath=<NAS_MOUNT_PATH>
DocumentStorage__MaxFileSizeBytes=52428800
DocumentStorage__AvailabilityProbeTimeoutSeconds=3
DocumentStorage__AvailabilityCacheSeconds=15
