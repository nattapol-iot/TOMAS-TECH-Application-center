# Reviewed template for the IoT Team Center frontend's build-time + systemd EnvironmentFile
# values on Ubuntu (self-hosted, not Vercel).
#
# Copy this file to an access-controlled location OUTSIDE the repository, replace every
# <PLACEHOLDER> below with a real reviewed value, then pass its path to
# deploy-frontend-release.sh via --env-file. deploy-frontend-release.sh installs it at
# /etc/iot-team-center/frontend.env (mode 640, owned by the frontend service user) and
# refuses to proceed if any <PLACEHOLDER> marker is still present.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle at build time -- they are
# configuration, not secrets (see docs/PRODUCTION_DEPLOYMENT.md), but are still kept out
# of git history and validated the same way as the backend's api.env.template.
# scripts/validate-production-env.mjs (unchanged, already in this repo) re-validates all
# of this during `npm run build` and fails the build on any placeholder/non-HTTPS value.

NEXT_PUBLIC_APP_MODE=production
NEXT_PUBLIC_AUTH_MODE=entra

# Exact public HTTPS origin of the API (no path, no trailing slash). If there's no
# domain yet, this is https://<SERVER_IP>:<API_EXTERNAL_PORT> (e.g. https://203.0.113.10:8443)
# using install-production-host.sh's --self-signed-tls defaults.
NEXT_PUBLIC_API_BASE_URL=<API_ORIGIN>

# Microsoft Entra tenant ID (GUID) -- same tenant as the API's Authentication__TenantId.
NEXT_PUBLIC_ENTRA_TENANT_ID=<TENANT_ID_GUID>
# Frontend SPA app registration's client ID (GUID) -- NOT the API's client ID.
NEXT_PUBLIC_ENTRA_CLIENT_ID=<SPA_CLIENT_ID_GUID>
# Full delegated scope, normally api://<API_CLIENT_ID_GUID>/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=api://<API_CLIENT_ID_GUID>/access_as_user

NEXT_PUBLIC_BUSINESS_TIME_ZONE=Asia/Bangkok

# Exact public HTTPS origin of this frontend itself (no path, no trailing slash). If
# there's no domain yet, this is https://<SERVER_IP> (port 443 is the --self-signed-tls
# default for the frontend, so it can be omitted from the origin).
SITE_ORIGIN=<FRONTEND_ORIGIN>
