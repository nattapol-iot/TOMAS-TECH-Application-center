# Local dev values for `docker compose -f docker-compose.dev.yml up`.
# Copy this file to .env (gitignored) and fill in real values -- never commit the copy.

# The existing shared team SQL Server (not containerized -- see docs/PRODUCTION_DEPLOYMENT.md
# for how the dedicated 'iot_team_app' login was created). Encrypt=True is required even
# for local dev; only TrustServerCertificate differs from production.
DEV_SQL_CONNECTION_STRING=Server=tcp:<SQL_HOST>,1433;Database=IoTTeamCenter;User ID=iot_team_app;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=True;

# Optional: only needed for the frontend's Entra sign-in button to render/work. The
# backend's Authentication:Mode=Development handler (see
# backend/IoTTeamCenter.Api/Infrastructure/DevelopmentAuthenticationHandler.cs) accepts
# every request as an authenticated dev user regardless of these -- leave blank to skip
# frontend login entirely and call the API directly (e.g. via curl/Postman) instead.
# Reuse the same API/SPA app registrations from scripts/New-EntraAppRegistrations.ps1 and
# add http://localhost:3000 as an extra SPA redirect URI in the Entra portal (Entra
# allows a plain http://localhost redirect for local dev; the script itself only accepts
# https:// since it's meant for the real deployment origin).
DEV_ENTRA_TENANT_ID=
DEV_ENTRA_CLIENT_ID=
DEV_ENTRA_API_SCOPE=

# --- TMT ID (Keycloak OIDC) -------------------------------------------------
# Set on the backend-node process, not in the frontend bundle. The frontend only
# needs NEXT_PUBLIC_AUTH_MODE=tmt-id and NEXT_PUBLIC_API_BASE_URL; the OIDC
# client is confidential and never reaches the browser.
#
# Authentication__Mode=TmtId
# OIDC_ISSUER=https://auth.tomastc.com/realms/internal
# OIDC_CLIENT_ID=iot-team-center
# OIDC_CLIENT_SECRET=<from the Keycloak client credentials tab -- never commit>
#
# PUBLIC_BASE_URL is the origin that owns the registered redirect URI
# <PUBLIC_BASE_URL>/api/auth/callback. APP_BASE_URL is where the browser is sent
# after login and logout; leave it unset when the app and the API share one
# origin, and set it when they are split across ports.
# PUBLIC_BASE_URL=https://iot-team-center.tomastc.com:8445
# APP_BASE_URL=https://iot-team-center.tomastc.com:8444
#
# SESSION_SECRET seals the session cookie (32-512 characters). It must be the
# same value for every worker and must survive restarts, or every signed-in
# person is logged out. SESSION_COOKIE_SECURE defaults to true and may only be
# false in development.
# SESSION_SECRET=<32+ random characters -- never commit>
# SESSION_COOKIE_SECURE=true
#
# Optional profile enrichment. The adapter stays dormant and makes no network
# call unless both are set.
# MASTER_DATA_URL=https://master-data.tomastc.com
# MASTER_DATA_API_KEY=<master-data API key -- never commit>