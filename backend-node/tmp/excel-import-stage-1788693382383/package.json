{
  "name": "@tomas-tech/iot-team-center-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:team-test": "pwsh -NoProfile -File scripts/Start-TeamTestNode.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.3",
    "jose": "6.2.11",
    "msnodesqlv8": "^5.3.0",
    "mssql": "12.7.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "22.19.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
