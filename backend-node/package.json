{
  "name": "@tomas-tech/iot-team-center-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/src/server.js",
    "start:team-test": "pwsh -NoProfile -File scripts/Start-TeamTestNode.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests/",
    "test:sql-integration": "bun tests/estimate-original-integration.ts && bun tests/overhead-integration.ts && bun tests/project-document-carryover-integration.ts && bun tests/erp-master-sync-integration.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.3",
    "fflate": "0.8.3",
    "jose": "6.2.11",
    "mssql": "12.7.0",
    "openid-client": "6.8.8",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
