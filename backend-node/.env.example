NODE_ENV=staging
HOST=127.0.0.1
PORT=5105

# Use the same SQL Server/database as the current API. Never commit real credentials.
ConnectionStrings__IoTTeamCenter=Server=localhost;Database=IoTTeamCenter_CodexTest_20260830_04;User ID=<APP_LOGIN>;Password=<SECRET>;Encrypt=true;TrustServerCertificate=true
Database__ApplicationRoleName=<APP_ROLE_NAME>
Database__ApplicationRolePassword=<BASE64URL_SECRET>
Database__TrustServerCertificateForTeamTest=true

Authentication__Mode=TeamTest
Authentication__TeamTestSigningKey=<RANDOM_32_TO_256_CHARACTER_SECRET>
# Entra production settings:
# Authentication__TenantId=<TENANT_GUID>
# Authentication__ClientId=<API_CLIENT_GUID>
# Authentication__Audience=<SAME_API_CLIENT_GUID>
# Authentication__RequiredScope=access_as_user

Cors__AllowedOrigins__0=http://127.0.0.1:3000
AllowedHosts=127.0.0.1;localhost
Business__TimeZoneId=Asia/Bangkok

DocumentStorage__Mode=Local
DocumentStorage__RootPath=App_Data/team-test-documents
DocumentStorage__MaxFileSizeBytes=52428800

# Assignment email. Keep Disabled in Team Test unless sending test mail is explicitly approved.
Email__Mode=Disabled
# Production Microsoft Graph settings (application permission: Mail.Send, admin consent required):
# Email__TenantId=<TENANT_GUID>
# Email__ClientId=<CONFIDENTIAL_APP_CLIENT_GUID>
# Email__ClientSecret=<SECRET_FROM_SECURE_HOST_CONFIGURATION>
# Email__SenderUser=iot-team-center@tomastc.com
# Email__ApplicationBaseUrl=https://iot-team-center.example.com
